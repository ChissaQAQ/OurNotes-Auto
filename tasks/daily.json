            "type": "switch",
            "label": "$opt.DailyStudio",
            "description": "$opt.DailyStudio.desc",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "OurNotesParam": {
                            "attach": {
                                "daily_studio": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "OurNotesParam": {
                            "attach": {
                                "daily_studio": false
                            }
                        }
                    }
                }
