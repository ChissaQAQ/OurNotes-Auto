{
    "task": [
        {
            "name": "领取日常",
            "entry": "OurNotes_Daily",
            "group": [
                "daily"
            ],
            "description": "依次打开选中的页面，「一键领取」亮着才点；领取后弹出的「获得奖励」只点 OK，认不出的确认框不点、报错停下。不会招募、使用星钻（商店里只领价格是「免费」的商品），不强化成员。游戏没在运行时先启动；结束时停在主界面。打完歌每日任务才满，放在演奏任务后面能一起领到。",
            "option": [
                "DailyStudio",
                "DailyStory",
                "DailyEvent",
                "DailyMissions",
                "DailyPass",
                "DailyLimited",
                "DailyBeginner",
                "DailyTgw",
                "DailyGifts"
            ],
            "default_check": true
        }
    ],
    "option": {
        "DailyStudio": {
            "type": "switch",
            "label": "录音室练习（收获）",
            "description": "领取成员练习的奖励。练习时间超过 12 小时后效率降低，一天领两次比较划算",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "OurNotesParam": {
                            "attach": {
                                "daily_studio": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "OurNotesParam": {
                            "attach": {
                                "daily_studio": false
                            }
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "DailyStory": {
            "type": "switch",
            "label": "看故事（跳过）",
            "description": "把没看过的乐队故事、视角故事、羁绊故事逐话跳过：看特定的话会解锁乐曲，看完还能领星钻等奖励。每话第一次看要下载数据（选无语音，乐队故事约 30MB），没看过的多时比较慢，默认不开。锁着的（没达成解锁条件、羁绊等级不够）不看",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "OurNotesParam": {
                            "attach": {
                                "daily_story": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "OurNotesParam": {
                            "attach": {
                                "daily_story": false
                            }
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "DailyEvent": {
            "type": "switch",
            "label": "活动故事（跳过）",
            "description": "限时活动期间，把活动页「活动故事」里没看过的活动故事、视角故事逐话跳过（看完能领奖励）。活动故事看完一话才解锁下一话；还锁着的不看。每话第一次看要下载数据，默认不开。没有限时活动时跳过",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "OurNotesParam": {
                            "attach": {
                                "daily_event": true
                            }
                        }
