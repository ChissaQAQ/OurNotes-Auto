{
    "task": [
        {
            "name": "启动游戏",
            "label": "$task.Start",
            "entry": "OurNotes_Start",
            "group": [
                "play"
            ],
            "description": "$task.Start.desc",
            "default_check": true
        },
        {
            "name": "切换账号",
            "label": "$task.SwitchAccount",
            "entry": "OurNotes_SwitchAccount",
            "group": [
                "play"
            ],
            "description": "$task.SwitchAccount.desc",
            "option": [
                "Account"
            ]
        }
    ],
    "option": {
        "Account": {
            "type": "input",
            "label": "$opt.Account",
            "inputs": [
                {
                    "name": "account",
                    "label": "$opt.Account.account",
                    "default": "",
                    "pipeline_type": "string",
                    "verify": "\\S",
                    "pattern_msg": "$opt.Account.account.msg"
                }
            ],
            "pipeline_override": { "OurNotesParam": { "attach": { "account": "{account}" } } }
        }
    }
}
