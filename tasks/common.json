{
    "option": {
        "SongMode": {
            "type": "select",
            "label": "$opt.SongMode",
            "cases": [
                {
                    "name": "current",
                    "label": "$opt.SongMode.current",
                    "description": "$opt.SongMode.current.desc",
                    "pipeline_override": { "OurNotesParam": { "attach": { "song_mode": "current" } } }
                },
                {
                    "name": "random",
                    "label": "$opt.SongMode.random",
                    "description": "$opt.SongMode.random.desc",
                    "pipeline_override": { "OurNotesParam": { "attach": { "song_mode": "random" } } }
                },
                {
                    "name": "ap_first",
                    "label": "$opt.SongMode.ap_first",
                    "description": "$opt.SongMode.ap_first.desc",
                    "pipeline_override": { "OurNotesParam": { "attach": { "song_mode": "ap_first" } } }
                },
                {
                    "name": "list",
                    "label": "$opt.SongMode.list",
                    "description": "$opt.SongMode.list.desc",
                    "option": ["SongList"],
                    "pipeline_override": { "OurNotesParam": { "attach": { "song_mode": "list" } } }
                }
            ],
            "default_case": "current"
        },
        "SongList": {
            "type": "input",
            "label": "$opt.SongList",
            "inputs": [
                {
                    "name": "songs",
                    "label": "$opt.SongList.songs",
                    "default": "",
                    "pipeline_type": "string",
                    "verify": "\\S",
                    "pattern_msg": "$opt.SongList.songs.msg"
                }
            ],
            "pipeline_override": { "OurNotesParam": { "attach": { "song_list": "{songs}" } } }
        },
        "Difficulty": {
            "type": "select",
            "label": "$opt.Difficulty",
            "cases": [
                {
                    "name": "expert",
                    "label": "EXPERT",
                    "pipeline_override": { "OurNotesParam": { "attach": { "difficulty": "expert" } } }
                },
                {
                    "name": "hard",
                    "label": "HARD",
                    "pipeline_override": { "OurNotesParam": { "attach": { "difficulty": "hard" } } }
                },
                {
                    "name": "normal",
                    "label": "NORMAL",
                    "pipeline_override": { "OurNotesParam": { "attach": { "difficulty": "normal" } } }
                },
                {
                    "name": "easy",
                    "label": "EASY",
                    "pipeline_override": { "OurNotesParam": { "attach": { "difficulty": "easy" } } }
                },
                {
                    "name": "high_first",
                    "label": "$opt.Difficulty.high_first",
                    "description": "$opt.Difficulty.high_first.desc",
                    "pipeline_override": { "OurNotesParam": { "attach": { "difficulty": "high_first" } } }
                }
            ],
            "default_case": "expert"
        },
        "MaxPlays": {
            "type": "input",
            "label": "$opt.MaxPlays",
            "inputs": [
                {
                    "name": "count",
                    "label": "$opt.MaxPlays.count",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^\\d+$",
                    "pattern_msg": "$opt.MaxPlays.count.msg"
                }
            ],
            "pipeline_override": { "OurNotesParam": { "attach": { "max_plays": "{count}" } } }
        },
        "Touch": {
            "type": "select",
            "label": "$opt.Touch",
            "description": "$opt.Touch.desc",
            "cases": [
                {
                    "name": "minitouch",
                    "label": "$opt.Touch.minitouch",
                    "pipeline_override": { "OurNotesParam": { "attach": { "touch": "minitouch" } } }
                },
                {
                    "name": "mumu",
                    "label": "$opt.Touch.mumu",
                    "description": "$opt.Touch.mumu.desc",
                    "pipeline_override": { "OurNotesParam": { "attach": { "touch": "mumu" } } }
                }
            ],
            "default_case": "minitouch"
        },
        "HumanBehavior": {
            "type": "switch",
            "label": "$opt.HumanBehavior",
            "description": "$opt.HumanBehavior.desc",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": { "OurNotesParam": { "attach": { "human_behavior": true } } }
                },
                {
                    "name": "No",
                    "pipeline_override": { "OurNotesParam": { "attach": { "human_behavior": false } } }
                }
            ],
            "default_case": "No"
        },
        "HumanGreat": {
            "type": "select",
            "label": "$opt.HumanGreat",
            "description": "$opt.HumanGreat.desc",
            "cases": [
                {
                    "name": "off",
                    "label": "$opt.HumanGreat.off",
                    "pipeline_override": { "OurNotesParam": { "attach": { "human_great": 0, "human_great_max": 0 } } }
                },
                {
                    "name": "1",
                    "label": "$opt.HumanGreat.1",
                    "pipeline_override": { "OurNotesParam": { "attach": { "human_great": 1, "human_great_max": 0 } } }
                },
                {
                    "name": "3",
                    "label": "$opt.HumanGreat.3",
                    "pipeline_override": { "OurNotesParam": { "attach": { "human_great": 3, "human_great_max": 0 } } }
                },
                {
                    "name": "5",
                    "label": "$opt.HumanGreat.5",
                    "pipeline_override": { "OurNotesParam": { "attach": { "human_great": 5, "human_great_max": 0 } } }
                },
                {
                    "name": "1_5",
                    "label": "$opt.HumanGreat.1_5",
                    "pipeline_override": { "OurNotesParam": { "attach": { "human_great": 1, "human_great_max": 5 } } }
                },
                {
                    "name": "1_10",
                    "label": "$opt.HumanGreat.1_10",
                    "pipeline_override": { "OurNotesParam": { "attach": { "human_great": 1, "human_great_max": 10 } } }
                }
            ],
            "default_case": "off"
        },
        "HumanTiming": {
            "type": "select",
            "label": "$opt.HumanTiming",
            "description": "$opt.HumanTiming.desc",
            "cases": [
                {
                    "name": "off",
                    "label": "$opt.HumanTiming.off",
                    "pipeline_override": { "OurNotesParam": { "attach": { "human_timing": 0 } } }
                },
                {
                    "name": "small",
                    "label": "$opt.HumanTiming.small",
                    "pipeline_override": { "OurNotesParam": { "attach": { "human_timing": 8 } } }
                },
                {
                    "name": "large",
                    "label": "$opt.HumanTiming.large",
                    "pipeline_override": { "OurNotesParam": { "attach": { "human_timing": 16 } } }
                }
            ],
            "default_case": "off"
        },
        "HumanPosition": {
            "type": "switch",
            "label": "$opt.HumanPosition",
            "description": "$opt.HumanPosition.desc",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": { "OurNotesParam": { "attach": { "human_position": true } } }
                },
                {
                    "name": "No",
                    "pipeline_override": { "OurNotesParam": { "attach": { "human_position": false } } }
                }
            ],
            "default_case": "No"
        },
        "DailyHours": {
            "type": "select",
            "label": "$opt.DailyHours",
            "description": "$opt.DailyHours.desc",
            "cases": [
                {
                    "name": "off",
                    "label": "$opt.DailyHours.off",
                    "pipeline_override": { "OurNotesParam": { "attach": { "daily_hours": 0 } } }
                },
                {
                    "name": "2",
                    "label": "$opt.DailyHours.2",
                    "pipeline_override": { "OurNotesParam": { "attach": { "daily_hours": 2 } } }
                },
                {
                    "name": "3",
                    "label": "$opt.DailyHours.3",
                    "pipeline_override": { "OurNotesParam": { "attach": { "daily_hours": 3 } } }
                },
                {
                    "name": "4",
                    "label": "$opt.DailyHours.4",
                    "pipeline_override": { "OurNotesParam": { "attach": { "daily_hours": 4 } } }
                },
                {
                    "name": "6",
                    "label": "$opt.DailyHours.6",
                    "pipeline_override": { "OurNotesParam": { "attach": { "daily_hours": 6 } } }
                },
                {
                    "name": "8",
                    "label": "$opt.DailyHours.8",
                    "pipeline_override": { "OurNotesParam": { "attach": { "daily_hours": 8 } } }
                }
            ],
            "default_case": "off"
        },
        "WatchCombo": {
            "type": "switch",
            "label": "$opt.WatchCombo",
            "description": "$opt.WatchCombo.desc",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": { "OurNotesParam": { "attach": { "watch_combo": true } } }
                },
                {
                    "name": "No",
                    "pipeline_override": { "OurNotesParam": { "attach": { "watch_combo": false } } }
                }
            ],
            "default_case": "No"
        },
        "RestartLowFps": {
            "type": "switch",
            "label": "$opt.RestartLowFps",
            "description": "$opt.RestartLowFps.desc",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": { "OurNotesParam": { "attach": { "restart_low_fps": true } } }
                },
                {
                    "name": "No",
                    "pipeline_override": { "OurNotesParam": { "attach": { "restart_low_fps": false } } }
                }
            ],
            "default_case": "Yes"
        },
        "StopAfterSong": {
            "type": "switch",
            "label": "$opt.StopAfterSong",
            "description": "$opt.StopAfterSong.desc",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": { "OurNotesParam": { "attach": { "finish_song_on_stop": true } } }
                },
                {
                    "name": "No",
                    "pipeline_override": { "OurNotesParam": { "attach": { "finish_song_on_stop": false } } }
                }
            ],
            "default_case": "No"
        },
        "GameLanguage": {
            "type": "select",
            "label": "$opt.GameLanguage",
            "description": "$opt.GameLanguage.desc",
            "cases": [
                {
                    "name": "default",
                    "label": "简体中文 / 繁體中文 / English",
                    "pipeline_override": { "OurNotesParam": { "attach": { "game_language": "default" } } }
                },
                {
                    "name": "ko",
                    "label": "한국어",
                    "pipeline_override": { "OurNotesParam": { "attach": { "game_language": "ko" } } }
                },
                {
                    "name": "ja",
                    "label": "$opt.GameLanguage.ja",
                    "pipeline_override": { "OurNotesParam": { "attach": { "game_language": "ja" } } }
                }
            ],
            "default_case": "default"
        },
        "DebugLog": {
            "type": "switch",
            "label": "$opt.DebugLog",
            "description": "$opt.DebugLog.desc",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": { "OurNotesParam": { "attach": { "debug_log": true } } }
                },
                {
                    "name": "No",
                    "pipeline_override": { "OurNotesParam": { "attach": { "debug_log": false } } }
                }
            ],
            "default_case": "No"
        },
        "CheckUpdate": {
            "type": "switch",
            "label": "$opt.CheckUpdate",
            "description": "$opt.CheckUpdate.desc",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": { "OurNotesParam": { "attach": { "check_update": true } } }
                },
                {
                    "name": "No",
                    "pipeline_override": { "OurNotesParam": { "attach": { "check_update": false } } }
                }
            ],
            "default_case": "Yes"
        },
        "AutoUpdate": {
            "type": "switch",
            "label": "$opt.AutoUpdate",
            "description": "$opt.AutoUpdate.desc",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": { "OurNotesParam": { "attach": { "auto_update": true } } }
                },
                {
                    "name": "No",
                    "pipeline_override": { "OurNotesParam": { "attach": { "auto_update": false } } }
                }
            ],
            "default_case": "Yes"
        },
        "Proxy": {
            "type": "input",
            "label": "$opt.Proxy",
            "description": "$opt.Proxy.desc",
            "inputs": [
                {
                    "name": "proxy",
                    "label": "$opt.Proxy.proxy",
                    "default": "",
                    "pipeline_type": "string",
                    "verify": "^\\S*$",
                    "pattern_msg": "$opt.Proxy.proxy.msg"
                }
            ],
            "pipeline_override": { "OurNotesParam": { "attach": { "proxy": "{proxy}" } } }
        },
        "NotifyChannel": {
            "type": "select",
            "label": "$opt.NotifyChannel",
            "description": "$opt.NotifyChannel.desc",
            "cases": [
                {
                    "name": "off",
                    "label": "$opt.NotifyChannel.off",
                    "pipeline_override": { "OurNotesParam": { "attach": { "notify_channel": "off" } } }
                },
                {
                    "name": "ntfy",
                    "label": "ntfy",
                    "description": "$opt.NotifyChannel.ntfy.desc",
                    "pipeline_override": { "OurNotesParam": { "attach": { "notify_channel": "ntfy" } } }
                },
                {
                    "name": "serverchan",
                    "label": "$opt.NotifyChannel.serverchan",
                    "description": "$opt.NotifyChannel.serverchan.desc",
                    "pipeline_override": { "OurNotesParam": { "attach": { "notify_channel": "serverchan" } } }
                },
                {
                    "name": "bark",
                    "label": "Bark",
                    "description": "$opt.NotifyChannel.bark.desc",
                    "pipeline_override": { "OurNotesParam": { "attach": { "notify_channel": "bark" } } }
                },
                {
                    "name": "webhook",
                    "label": "Webhook",
                    "description": "$opt.NotifyChannel.webhook.desc",
                    "pipeline_override": { "OurNotesParam": { "attach": { "notify_channel": "webhook" } } }
                }
            ],
            "default_case": "off"
        },
        "NotifyTarget": {
            "type": "input",
            "label": "$opt.NotifyTarget",
            "description": "$opt.NotifyTarget.desc",
            "inputs": [
                {
                    "name": "target",
                    "label": "$opt.NotifyTarget.target",
                    "default": "",
                    "pipeline_type": "string",
                    "verify": "^\\S*$",
                    "pattern_msg": "$opt.NotifyTarget.target.msg"
                }
            ],
            "pipeline_override": { "OurNotesParam": { "attach": { "notify_target": "{target}" } } }
        },
        "NotifyEvents": {
            "type": "select",
            "label": "$opt.NotifyEvents",
            "cases": [
                {
                    "name": "all",
                    "label": "$opt.NotifyEvents.all",
                    "pipeline_override": { "OurNotesParam": { "attach": { "notify_events": "all" } } }
                },
                {
                    "name": "problems",
                    "label": "$opt.NotifyEvents.problems",
                    "pipeline_override": { "OurNotesParam": { "attach": { "notify_events": "problems" } } }
                }
            ],
            "default_case": "all"
        }
    }
}
