{
    "option": {
        "SongMode": {
            "type": "select",
            "label": "$opt.SongMode",
            "cases": [
                {
                    "name": "current",
                    "label": "$opt.SongMode.current",
                    "description": "$opt.SongMode.current.desc",
                    "pipeline_override": { "OurNotesParam": { "attach": { "song_mode": "current" } } }
                },
                {
                    "name": "random",
                    "label": "$opt.SongMode.random",
                    "description": "$opt.SongMode.random.desc",
                    "pipeline_override": { "OurNotesParam": { "attach": { "song_mode": "random" } } }
                },
                {
                    "name": "ap_first",
                    "label": "$opt.SongMode.ap_first",
                    "description": "$opt.SongMode.ap_first.desc",
                    "pipeline_override": { "OurNotesParam": { "attach": { "song_mode": "ap_first" } } }
                },
                {
                    "name": "list",
                    "label": "$opt.SongMode.list",
                    "description": "$opt.SongMode.list.desc",
                    "option": ["SongList"],
                    "pipeline_override": { "OurNotesParam": { "attach": { "song_mode": "list" } } }
                }
            ],
            "default_case": "current"
        },
        "SongList": {
            "type": "input",
            "label": "$opt.SongList",
            "inputs": [
                {
                    "name": "songs",
                    "label": "$opt.SongList.songs",
                    "default": "",
                    "pipeline_type": "string",
                    "verify": "\\S",
                    "pattern_msg": "$opt.SongList.songs.msg"
                }
            ],
            "pipeline_override": { "OurNotesParam": { "attach": { "song_list": "{songs}" } } }
        },
        "Difficulty": {
            "type": "select",
            "label": "$opt.Difficulty",
            "cases": [
                {
                    "name": "expert",
                    "label": "EXPERT",
                    "pipeline_override": { "OurNotesParam": { "attach": { "difficulty": "expert" } } }
                },
                {
                    "name": "hard",
                    "label": "HARD",
                    "pipeline_override": { "OurNotesParam": { "attach": { "difficulty": "hard" } } }
                },
                {
                    "name": "normal",
                    "label": "NORMAL",
                    "pipeline_override": { "OurNotesParam": { "attach": { "difficulty": "normal" } } }
                },
                {
                    "name": "easy",
                    "label": "EASY",
                    "pipeline_override": { "OurNotesParam": { "attach": { "difficulty": "easy" } } }
                },
                {
                    "name": "high_first",
                    "label": "$opt.Difficulty.high_first",
                    "description": "$opt.Difficulty.high_first.desc",
                    "pipeline_override": { "OurNotesParam": { "attach": { "difficulty": "high_first" } } }
                }
            ],
            "default_case": "expert"
        },
        "MaxPlays": {
            "type": "input",
            "label": "$opt.MaxPlays",
            "inputs": [
                {
                    "name": "count",
                    "label": "$opt.MaxPlays.count",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^\\d+$",
                    "pattern_msg": "$opt.MaxPlays.count.msg"
                }
            ],
            "pipeline_override": { "OurNotesParam": { "attach": { "max_plays": "{count}" } } }
        },
        "Touch": {
            "type": "select",
            "label": "$opt.Touch",
            "description": "$opt.Touch.desc",
            "cases": [
                {
                    "name": "minitouch",
                    "label": "$opt.Touch.minitouch",
                    "pipeline_override": { "OurNotesParam": { "attach": { "touch": "minitouch" } } }
                },
                {
                    "name": "mumu",
                    "label": "$opt.Touch.mumu",
                    "description": "$opt.Touch.mumu.desc",
                    "pipeline_override": { "OurNotesParam": { "attach": { "touch": "mumu" } } }
                }
            ],
            "default_case": "minitouch"
        },
        "HumanGreat": {
            "type": "select",
            "label": "$opt.HumanGreat",
            "description": "$opt.HumanGreat.desc",
            "cases": [
                {
                    "name": "off",
                    "label": "$opt.HumanGreat.off",
                    "pipeline_override": { "OurNotesParam": { "attach": { "human_great": 0 } } }
                },
                {
                    "name": "1",
                    "label": "$opt.HumanGreat.1",
                    "pipeline_override": { "OurNotesParam": { "attach": { "human_great": 1 } } }
                },
                {
                    "name": "3",
                    "label": "$opt.HumanGreat.3",
                    "pipeline_override": { "OurNotesParam": { "attach": { "human_great": 3 } } }
                },
                {
                    "name": "5",
                    "label": "$opt.HumanGreat.5",
                    "pipeline_override": { "OurNotesParam": { "attach": { "human_great": 5 } } }
                }
            ],
            "default_case": "off"
        },
        "HumanTiming": {
            "type": "select",
            "label": "$opt.HumanTiming",
            "description": "$opt.HumanTiming.desc",
            "cases": [
                {
                    "name": "off",
                    "label": "$opt.HumanTiming.off",
                    "pipeline_override": { "OurNotesParam": { "attach": { "human_timing": 0 } } }
                },
                {
                    "name": "small",
                    "label": "$opt.HumanTiming.small",
                    "pipeline_override": { "OurNotesParam": { "attach": { "human_timing": 8 } } }
                },
                {
                    "name": "large",
                    "label": "$opt.HumanTiming.large",
                    "pipeline_override": { "OurNotesParam": { "attach": { "human_timing": 16 } } }
                }
            ],
            "default_case": "off"
        },
        "HumanPosition": {
            "type": "switch",
            "label": "$opt.HumanPosition",
            "description": "$opt.HumanPosition.desc",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": { "OurNotesParam": { "attach": { "human_position": true } } }
                },
                {
                    "name": "No",
                    "pipeline_override": { "OurNotesParam": { "attach": { "human_position": false } } }
                }
            ],
            "default_case": "No"
        },
        "WatchCombo": {
            "type": "switch",
            "label": "$opt.WatchCombo",
            "description": "$opt.WatchCombo.desc",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": { "OurNotesParam": { "attach": { "watch_combo": true } } }
                },
                {
                    "name": "No",
                    "pipeline_override": { "OurNotesParam": { "attach": { "watch_combo": false } } }
                }
            ],
            "default_case": "No"
        },
        "GameLanguage": {
            "type": "select",
            "label": "$opt.GameLanguage",
            "description": "$opt.GameLanguage.desc",
            "cases": [
                {
                    "name": "default",
                    "label": "简体中文 / 繁體中文 / English",
                    "pipeline_override": { "OurNotesParam": { "attach": { "game_language": "default" } } }
                },
                {
                    "name": "ko",
                    "label": "한국어",
                    "pipeline_override": { "OurNotesParam": { "attach": { "game_language": "ko" } } }
                }
            ],
            "default_case": "default"
        },
        "DebugLog": {
            "type": "switch",
            "label": "$opt.DebugLog",
            "description": "$opt.DebugLog.desc",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": { "OurNotesParam": { "attach": { "debug_log": true } } }
                },
                {
                    "name": "No",
                    "pipeline_override": { "OurNotesParam": { "attach": { "debug_log": false } } }
                }
            ],
            "default_case": "No"
        },
        "CheckUpdate": {
            "type": "switch",
            "label": "$opt.CheckUpdate",
            "description": "$opt.CheckUpdate.desc",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": { "OurNotesParam": { "attach": { "check_update": true } } }
                },
                {
                    "name": "No",
                    "pipeline_override": { "OurNotesParam": { "attach": { "check_update": false } } }
                }
            ],
            "default_case": "Yes"
        }
    }
}
